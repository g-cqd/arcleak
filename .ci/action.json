{
  "swift": {
    "parallel": false
  },
  "quality": {
    "paths": [
      "Sources"
    ],
    "include": [
      "/Package.swift",
      "Sources/**",
      "Plugins/**",
      "Tests/ArcLeakCoreTests/*.swift"
    ]
  },
  "release": {
    "executables": [
      "arcleak"
    ]
  },
  "commands": [
    {
      "id": "no-gcd",
      "run": "Scripts/no-gcd.sh",
      "after": "quality",
      "title": "Quality · GCD Ban"
    },
    {
      "id": "self-analysis",
      "run": "swift run arcleak analyze Sources --strict --no-cache",
      "after": "linux-debug",
      "title": "Quality · Self Analysis"
    },
    {
      "id": "leak-oracle",
      "run": "swift build --product leak-oracle && Scripts/run-leak-oracle.sh \"$(swift build --show-bin-path)/leak-oracle\"",
      "after": "macos-debug",
      "title": "Integration · Leak Oracle"
    },
    {
      "id": "lsp-smoke",
      "run": "swift build --product arcleak && Scripts/lsp-smoke.sh \"$(swift build --show-bin-path)/arcleak\"",
      "after": "macos-debug",
      "title": "Integration · Language Server Smoke"
    },
    {
      "id": "benchmarks",
      "title": "Performance · Benchmarks against the Commit Before",
      "os": "macOS",
      "cadence": [
        "push",
        "nightly",
        "dispatch"
      ],
      "paths": [
        "Sources/**",
        "Benchmarks/**",
        "Package.swift",
        "Package.resolved",
        ".ci/action.json",
        ".github/workflows/**"
      ],
      "benchmark": {}
    }
  ],
  "localChecks": [
    "quality",
    "debug",
    "self-analysis"
  ]
}
